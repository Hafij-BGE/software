         _ => "application/octet-stream",
     }
 }
+
+// ---- Craft Suite for Android --------------------------------------------------------------------
+// android-shim.js runs the app's own commands through these (its read-only mode): at once, or right
+// after the file it hands the app has opened.
+
+thread_local! {
+    static CRAFT_SUITE_NOW: std::cell::RefCell<Vec<(String, String)>> = const { std::cell::RefCell::new(Vec::new()) };
+    static CRAFT_SUITE_AFTER_OPEN: std::cell::RefCell<Vec<(String, String)>> = const { std::cell::RefCell::new(Vec::new()) };
+    static CRAFT_SUITE_CTX: std::cell::RefCell<Option<egui::Context>> = const { std::cell::RefCell::new(None) };
+}
+
+fn craft_suite_wake() {
+    CRAFT_SUITE_CTX.with(|c| {
+        if let Some(ctx) = c.borrow().as_ref() {
+            ctx.request_repaint();
+        }
+    });
+}
+
+/// Runs one of the app's commands (`params`: JSON) on the next frame.
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub fn craft_suite_command(id: String, params: String) {
+    CRAFT_SUITE_NOW.with(|q| q.borrow_mut().push((id, params)));
+    craft_suite_wake();
+}
+
+/// Runs one of the app's commands once the next file handed to the app has opened.
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub fn craft_suite_after_open(id: String, params: String) {
+    CRAFT_SUITE_AFTER_OPEN.with(|q| q.borrow_mut().push((id, params)));
+}
+
+fn craft_suite_commands(app: &mut SlideApp, ctx: &egui::Context, opened: bool) {
+    CRAFT_SUITE_CTX.with(|c| {
+        let mut c = c.borrow_mut();
+        if c.is_none() {
+            *c = Some(ctx.clone());
+        }
+    });
+    let mut run = CRAFT_SUITE_NOW.with(|q| std::mem::take(&mut *q.borrow_mut()));
+    if opened {
+        run.extend(CRAFT_SUITE_AFTER_OPEN.with(|q| std::mem::take(&mut *q.borrow_mut())));
+    }
+    for (id, params) in run {
+        let params = serde_json::from_str(&params).unwrap_or_else(|_| serde_json::json!({}));
+        // A step that doesn't apply (a sheet that isn't there) is skipped.
+        let _ = app.run(&id, params);
+    }
+    if opened {
+        ctx.request_repaint();
+    }
+}
