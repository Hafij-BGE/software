[Desktop Entry]
Type=Application
Name=DeckCraft
GenericName=Presentation
Comment=Make slides; open and save PowerPoint files (a new tab in Craft Suite)
Exec=craft-suite --new deck
TryExec=craft-suite
Icon=ai.storyteller.deckcraft
Terminal=false
StartupNotify=true
StartupWMClass=craft-suite
Categories=Office;Presentation;
